{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "ID of the conversation"
    },
    "sender_email": {
      "type": "string",
      "description": "Email of the sender"
    },
    "content": {
      "type": "string",
      "description": "The message content"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the message has been read"
    }
  },
  "required": [
    "conversation_id",
    "sender_email",
    "content"
  ]
}